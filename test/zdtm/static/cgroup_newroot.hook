#!/bin/bash

[ "$1" == "--clean" ] || exit 0

set -e

# Remove a cgroup with all its descendants, the deepest ones first.
rmtree() {
	test -d "$1" || return 0
	find "$1" -depth -type d -exec rmdir {} +
}

tname=$(mktemp -d cgclean.XXXXXX)
trap 'rmdir "$tname"' EXIT

# A failure to remove a cgroup (e.g. a busy one) is reported, but only
# once the hierarchy is unmounted.
ret=0

mount -t cgroup none "$tname" -o none,name=zdtmtst
rmtree "$tname/cgroup_newroot" || ret=1
rmtree "$tname/newroot" || ret=1
umount "$tname"

mount -t cgroup none "$tname" -o none,name=zdtmtst.defaultroot
rmtree "$tname/cgroup_newroot" || ret=1
umount "$tname"

exit $ret
